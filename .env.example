# Database (MySQL 8.0+)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=change-me
DB_NAME=wanye

# API Server
PORT=9200
JWT_SECRET=change-me-in-production
JWT_EXPIRY=24h

# SMTP (leave empty to log tokens to stdout)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:9200/api/auth/google/callback
# iOS native Google Sign-In (OAuth client ID for com.wanye.deimos)
GOOGLE_IOS_CLIENT_ID=

# iOS Info.plist keys (aligned with voyager conventions):
# GIDClientID — same as GOOGLE_IOS_CLIENT_ID
# WeChatAppID / WeChatUniversalLink — WeChat Open Platform
# GoogleService-Info.plist — copy from Deimos/Resources/GoogleService-Info.sample.plist (gitignored)
# Xcode build settings: GOOGLE_REVERSED_CLIENT_ID, WECHAT_URL_SCHEME (wx + AppID)

# Frontend
FRONTEND_URL=http://localhost:3000

# Frontend (runtime, injected at container start)
API_URL=http://localhost:9200

# ========== Server deploy (docker-compose.server.yml) ==========
# 与同机 grapery 错开端口：grapery 用 3000/8080，本地开发 API 默认 9200
# IDEAEVO_API_PORT=8090
# IDEAEVO_WEB_PORT=3001
# IDEAEVO_PUBLIC_API_URL=https://www.ideavalues.xyz
# IDEAEVO_API_MEM_LIMIT=128m
# IDEAEVO_WEB_MEM_LIMIT=384m
# IDEAEVO_NODE_OPTIONS=--max-old-space-size=320

# LLM 对话 — 留空则 Mock 回复
#
# 本地测试（火山方舟，与 grapery 对齐）:
#   HUOSHAN_API_KEY=方舟 API Key（控制台 → API Key 管理）
#   HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
#   HUOSHAN_TEXT_MODEL=ep-xxxxxxxx   # 推理接入点 ID，强烈建议配置
#   勿同时设置 LLM_API_KEY（优先级更高，会覆盖火山）
#
# HUOSHAN_CLOUD_KEY / HUOSHAN_CLOUD_SECRET 为火山云 AK/SK，ideaevo 对话 LLM 不使用；
# 与 grapery 一样，聊天走 HUOSHAN_API_KEY + 官方 arkruntime SDK。
#
# 线上部署：GitHub Actions 从仓库 vars 注入 HUOSHAN_API_KEY / HUOSHAN_BASE_URL / HUOSHAN_TEXT_MODEL
# （见 .github/workflows/api-ci.yml，与 grapery server-ci 共用同名 vars）
LLM_API_KEY=
# HUOSHAN_API_KEY=
# HUOSHAN_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# HUOSHAN_TEXT_MODEL=ep-xxxxxxxxxx-xxxxx
LLM_BASE_URL=https://api.openai.com/v1
# 未设 HUOSHAN_TEXT_MODEL 时默认 doubao-seed-2-0-lite-260215；自定义接入点请设 ep-xxx
LLM_MODEL=gpt-4o

# System Agent (optional, ID of the default assistant agent)
# 留空时启动会自动创建一个名为「万叶助手」的内置 agent 作为页面聊天默认对象
SYSTEM_AGENT_ID=

# ========== Vector Search ==========
# 推荐：百炼 DashVector（VECTOR_BACKEND=dashvector）
# 备选：OSS 向量 Bucket（VECTOR_BACKEND=oss）
#
# --- DashVector（推荐）---
# 本地开发：填在 .env；服务器 deploy：由 GitHub Actions vars 注入（development / production 各配一套）
#   DASHSCOPE_API_KEY、DASHVECTOR_ENDPOINT
# VECTOR_BACKEND=dashvector
# DASHVECTOR_ENDPOINT=https://vrs-cn-xxxx.dashvector.cn-hangzhou.aliyuncs.com
# DASHVECTOR_METRIC=cosine
# DASHSCOPE_API_KEY=                    # embedding + DashVector 鉴权共用
# VECTOR_INDEX_IDEAS=ideas              # Collection 名称
# EMBEDDING_MODEL=text-embedding-v4
# EMBEDDING_DIMENSIONS=1536
# VECTOR_REINDEX_ON_START=true          # 启动时异步回填 active ideas（首次迁移可用）
#
# --- OSS 向量 Bucket（遗留，可选）---
# 鉴权：ALIYUN_OSS_ACCESS_KEY_ID → ALIYUN_ACCESS_KEY_ID → ALIYUN_SMS_ACCESS_KEY_ID
# VECTOR_BACKEND=oss
# ALIYUN_VECTOR_BUCKET=ideaevo-vectors-prod
# ALIYUN_VECTOR_REGION=cn-shanghai
# ALIYUN_VECTOR_ACCOUNT_ID=1866841989078847

# ========== WeChat Open Platform (网站应用扫码) ==========
# WECHAT_APP_ID=
# WECHAT_APP_SECRET=
# WECHAT_REDIRECT_URL=http://localhost:9200/api/auth/wechat/callback

# Sign in with Apple (iOS app bundle ID, used as identity token audience)
APPLE_BUNDLE_ID=com.wanye.deimos

# ========== Aliyun OSS user assets (普通 bucket，非向量 bucket) ==========
# 复用上方同一套 AccessKey（见鉴权优先级说明）
# ALIYUN_ASSETS_BUCKET=ideaevo
# ALIYUN_ASSETS_REGION=cn-shanghai
# ALIYUN_ASSETS_CDN_DOMAIN=                    # 可选；留空则用 https://ideaevo.oss-cn-shanghai.aliyuncs.com
# 部署提示：Bucket 需配置 CORS 允许浏览器 PUT；头像/背景需公共读或走 CDN 域名

# ========== Aliyun SMS (手机验证码，与 grapery 变量名一致) ==========
# 签名/模板未配置时使用代码默认值（上海秩量科技 / SMS_333971751）
# ALIYUN_SMS_SIGN_NAME=
# ALIYUN_SMS_TEMPLATE_CODE=
# ALIYUN_SMS_REGION=cn-hangzhou
# ALIYUN_SMS_ENDPOINT=dysmsapi.aliyuncs.com
# 凭证（按优先级）：SMS 专用 Key → 通用 Aliyun Key → OSS Key → ECS RAM 角色链
# ALIYUN_SMS_ACCESS_KEY_ID=          # CI: vars.ALIYUN_SMS_ACCESS_ID
# ALIYUN_SMS_ACCESS_KEY_SECRET=      # CI: vars.ALIYUN_SMS_ACCESS_SECRET
# ALIYUN_SMS_USE_DEFAULT_CREDENTIAL=1  # ECS 部署时与 grapery 一致，启用 RAM 凭证链
# 未配置任何凭证时 OTP 打印到 stdout（开发模式）

# ========== Payment / Subscription (充值会员模块) ==========
# 计费模块：免费用户每日 1W token、不能创建 Agent、不能用 MCP；
# 付费 Pro 用户（19.9 RMB / 9.9 USD 每月）每日 1000W token、可建 10 个 Agent、可用 MCP。
#
# 支付网关凭证缺失时自动降级为「模拟支付」模式（mock），整条链路仍可联调：
#   下单 → 模拟支付页 → 激活会员。配置真实凭证后无缝切换。
#
# 支付宝（电脑网站支付 alipay.trade.page.pay）
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY=                  # 应用私钥（RSA2，PKCS1/PKCS8）
# ALIPAY_PUBLIC_KEY=                   # 支付宝公钥
# ALIPAY_NOTIFY_URL=                   # 异步回调，如 https://your-host/api/billing/webhooks/alipay
# ALIPAY_SANDBOX=false                 # 沙箱环境设 true

# 微信支付（Native 扫码支付）
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=                   # 商户号
# WECHAT_PAY_API_KEY=                  # API v3 密钥（32 字节，解密回调 resource）
# WECHAT_PAY_NOTIFY_URL=               # 异步回调，如 https://your-host/api/billing/webhooks/wechat
# WECHAT_PAY_PLATFORM_PUBLIC_KEY=      # 微信支付平台公钥/证书公钥（PEM 或裸 base64），校验 Wechatpay-Signature

# Stripe（Checkout Sessions，用于 USD 支付）
# STRIPE_API_KEY=                      # sk_live_... 或 sk_test_...
# STRIPE_WEBHOOK_SECRET=               # whsec_...，用于校验 webhook 签名

# Webhook 验签：各网关回调均需验签后才入账；凭证未配置时对应网关回调直接拒绝。
# mock 网关回调无签名可验，默认拒绝；仅本地联调需要时显式开启（生产必须留空）。
# MOCK_PAY_WEBHOOK_ENABLED=false

